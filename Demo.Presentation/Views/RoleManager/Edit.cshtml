@using Demo.Presentation.ViewModels.RoleViewModels
@model RoleEditViewModel
@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center align-content-center mt-3">
    <h1 class="col-8 my-4">Edit @Model.RoleName Role</h1>
    <form method="post" asp-action="Edit" class="col-8">
        <div asp-validation-summary="All"></div>


	<div class="mb-3">
		<label class="form-label" asp-for="Id"></label>
		<input asp-for="Id" class="form-control"  />
			<span asp-validation-for="Id" class="text-danger"></span>
	</div>
	<div class="mb-3">
		<label class="form-label" asp-for="RoleName"></label>
		<input asp-for="RoleName" class="form-control"  />
			<span asp-validation-for="RoleName" class="text-danger"></span>
	</div>
        <div class="mt-4 m-auto">
            <input class="btn btn-success" type="submit" value="Save" />
            <a asp-action="Index" class="btn btn-outline-dark">Back to list</a>
    </div>
    </form>
</div>