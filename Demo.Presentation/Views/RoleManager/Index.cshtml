@using Demo.Presentation.ViewModels.RoleViewModels
@using Microsoft.AspNetCore.Identity
@model IEnumerable<IdentityRole>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<h1 class="my-3">All Roles</h1>

@*Add Bar*@
<div class="m-2">
    <form asp-action="Index" class="row offset-2" method="get">
        <div asp-validation-summary="ModelOnly"></div>
        <div class="col-8">
            <input class="form-control" type="text" name="AddKey" placeholder="Add New Role">
        </div>
        <div class="col-4">
            <input class="btn btn-outline-success" type="submit" value="Create" />
        </div>
    </form>
</div>


@*Search Bar*@
<div class="m-2">
    <form asp-action="Index" class="row offset-2" method="get">

        <div class="col-8">
            <input class="form-control" type="text" name="SearchKey" placeholder="Search Role By Name">
        </div>
        <div class="col-4">
            <input class="btn btn-outline-success" type="submit" value="Search" />
        </div>

    </form>
</div>


@*Delete Confirmation message*@
@if (!string.IsNullOrWhiteSpace(TempData["Message"] as string))
{
    <div aria-live="polite" aria-atomic="true" class="toast-container position-fixed p-3" style="bottom: 25px; right:25px; z-index: 100;">
        <div class="toast fade show " role="alert" aria-live="assertive" aria-atomic="true">
            <div class="toast-header">
                <strong class="me-auto text-success">Success!!</strong>
                <small>Just now</small>
                <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
            <div class="toast-body">
                @TempData["Message"]
            </div>
        </div>
    </div>

}



@if (Model.Any())
{
    <table class="table table-striped table-hover mt-2 text-start">

        <thead>
            <tr>
                <th>@Html.DisplayNameFor(U => U.Id)</th>
                <th>@Html.DisplayNameFor(U => U.Name)</th>
                <th>Details</th>
                <th>Update</th>
                <th>Delete</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var User in Model)
            {
                <tr>

                    <td>@User.Id</td>
                    <td>@User.Name</td>
                  
                    <td><a class="btn " style="color: darkcyan;" asp-action="Details" asp-Route-Id="@User.Id"><i class="fa-solid fa-eye"></i></a></td>
                    <td><a class="btn " style="color: gold;" asp-action="Edit" asp-Route-Id="@User.Id"><i class="fa-solid fa-pen-to-square"></i></a></td>
                    <td><a class="btn " style="color: tomato" asp-action="Delete" asp-Route-Id="@User.Id"><i class="fa-solid fa-trash"></i></a></td>
                </tr>

            }
        </tbody>

    </table>
}
else
{
    <div class="alert alert-info mt-2">
        <h2>No Users Found</h2>
    </div>
}

