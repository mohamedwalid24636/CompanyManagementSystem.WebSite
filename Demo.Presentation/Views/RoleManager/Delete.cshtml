@using Demo.Presentation.ViewModels.RoleViewModels
@model RoleDetailsViewModel
@{
    ViewData["Title"] = "Delete";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Are You Sure You Want to Delete @Model.RoleName</h1>



<partial name="RoleDetailsDeletePartialView" >

    <div class="mt-4">
        <form method="post"  asp-action="DeleteConfirm" asp-route-id="@Model.Id">
            <input type="submit" class="btn btn-danger" value="Confirm" />
            <a asp-action="Index" class="btn btn-outline-dark">Cancel</a>
        </form>
    </div>

