@using Demo.Presentation.ViewModels.AccountViewModels
@model ForgetPasswordViewModel

@{
    ViewData["Title"] = "Forget Password";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="main-agileinfo">
    <div class="agileits-top">

        <div style="text-align:center; margin-bottom:25px;">
            <h2 style="margin:0; color:white; font-size:32px;">
                Forget Password
            </h2>
            <p style="margin-top:10px; color:#ddd;">
                Enter your email address to receive a password reset link.
            </p>
        </div>

        <form asp-action="SendResetPasswordLink" method="post">
            <div asp-validation-summary="ModelOnly"></div>

            <input asp-for="Email" placeholder="Email Address" required="">
            <span asp-validation-for="Email"></span>

            <br />

            <input type="submit" value="Send Reset Link">
        </form>

        <p style="text-align:center; margin-top:20px;">
            Remember your password?
            <a asp-action="Login">Login</a>
        </p>

    </div>
</div>