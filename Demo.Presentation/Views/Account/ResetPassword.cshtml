@using Demo.Presentation.ViewModels.AccountViewModels
@model ResetPasswordViewModel

@{
    ViewData["Title"] = "Reset Password";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="main-agileinfo">
    <div class="agileits-top">

        <h2 style="text-align:center; margin-bottom:25px; color:white; font-size:35px; font-weight:600;">
            Reset Password
        </h2>

        <form asp-action="ResetPassword" method="post">
            <div asp-validation-summary="All"></div>

            <input asp-for="Password" placeholder="New Password" required="">
            <span asp-validation-for="Password"></span>
            <br />

            <input asp-for="ConfirmPassword" placeholder="Confirm New Password" required="">
            <span asp-validation-for="ConfirmPassword"></span>
            <br />

            <input type="submit" value="CHANGE PASSWORD">
        </form>

        <p><a asp-action="Login">Back to Login</a></p>

    </div>
</div>