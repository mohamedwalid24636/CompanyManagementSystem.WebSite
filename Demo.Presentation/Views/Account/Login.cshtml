@using Demo.Presentation.ViewModels.AccountViewModels
@model LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="main-agileinfo">
    <div class="agileits-top">
        <div style="text-align:center; margin-bottom:25px;">
            <h2 style="color:white; margin:0;">Welcome Back</h2>
            <p style="color:#ddd; margin-top:8px;">Login to your account</p>
        </div>
        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly"></div>                   @*"All"" Or "ModelOnly"*@

            <input asp-for="Email" placeholder="Email" required="">
            <span asp-validation-for="Email"></span>                  @*الرسالة اللي بتظهر بعد تحت المربع بتاع ال email لما تدخل البيانات غلط *@
            <br />
            <input asp-for="Password" placeholder="Password" required="">
            <span asp-validation-for="Password"></span>
            <br />

            <div class="wthree-text">
                <label class="anim">
                    <input asp-for="RememberMe" class="checkbox" >
                    <span>Keep Me Signed In</span>
                </label>
                <div class="clear"> </div>
            </div>
            <input type="submit" value="SIGNIN">
        </form>
        <p>Don't have an Account? <a asp-action="Register"> Register Now!</a></p>
        <p><a asp-action="ForgetPassword" >Forget Password</a></p>
    </div>
</div>

