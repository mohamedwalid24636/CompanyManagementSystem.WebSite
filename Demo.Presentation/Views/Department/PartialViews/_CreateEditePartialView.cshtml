@model DepartmentViewModel



<div class="form-group mb-3">
	@* <label class="form-label" for="Code"></label> *@
	@* <input id="Code" name="Code" type="text" /> *@
	<label class="form-label" asp-for="Code"></label> @*asp-for ---> الاسم اللي هيظهر ف يالمربع*@
	<input asp-for="Code" class="form-control" /> @*asp-for ---> name , id *@
	<span asp-validation-for="Code" class="text-danger"></span>
</div>
<div class="form-group mb-3">
	<label class="form-label" asp-for="Name"></label>
	<input asp-for="Name" class="form-control" />
	<span asp-validation-for="Name" class="text-danger"></span>
</div>
<div class="form-group mb-3">
	<label class="form-label" asp-for="Description"></label>
	<textarea class="form-control" asp-for="Description"></textarea>
</div>
<div class="form-group mb-3">
	<label class="form-label" asp-for="CreatedOn"></label>
	<input type="date" asp-for="CreatedOn" class="form-control" />
</div>