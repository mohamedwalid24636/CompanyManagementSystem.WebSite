@using Demo.BusinessLogic.DataTransfareObject.DepartmentDtos
@model IEnumerable<DepartmentDto>  // Assuming you have a DepartmentDto model نوع المودل اللي انت هتستخدمه هنا )باعته )
@{
    ViewData["Title"] = "Index";
    // var Departmnet = ViewData["Message"] as DepartmentDto ; 
}


@if (!string.IsNullOrWhiteSpace(TempData["Message"] as string))
{
    <div aria-live="polite" aria-atomic="true" class="toast-container position-fixed p-3" style="bottom: 25px; right:25px; z-index: 100;">
        <div class="toast fade show " role="alert" aria-live="assertive" aria-atomic="true">
            <div class="toast-header">
                <strong class="me-auto text-success">Success!!</strong>
                <small>Just now</small>
                <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
            <div class="toast-body">
                @TempData["Message"]
            </div>
        </div>
    </div>

}





<h1 class="my-3">All Departments</h1> @* // my-3 is a Bootstrap class for margin بيسيب مسافة فوق وتحت  *@

<a class="btn btn-primary my-3" asp-controller="Department" asp-action="Create">Create New Department</a>
@if (Model.Any()) // Check if there are any departments to display اللي جايالك من اول سطر 
{
    <table class="table table-striped table-hover mt-2" >
        <thead class="text-center">
            <tr>
                <th>@Html.DisplayNameFor(D=>D.Code)</th>
                <th>@Html.DisplayNameFor(D=>D.name)</th>
                <th>@Html.DisplayNameFor(D=>D.Description)</th>
                <th>@Html.DisplayNameFor(D => D.DateOfCreation)</th>
                <th>Details</th>
                <th>Update</th>
                <th>Delete</th>
            </tr>
        </thead >

        <tbody class ="text-center">
			@foreach (var Department in Model)
			{
				<tr>
					<td>@Department.Code</td>
					<td>@Department.name</td>
					<td>@Department.Description</td>
					<td>@Department.DateOfCreation</td>


					@* @Html.PartialAsync("_ButtonsPartialView", Department.DeptId) *@  @* This will render the buttons partial view with the Department ID *@
					@* Details Button *@
                    <partial name="_ButtonsPartialView" model = "Department.DeptId" />


                  @*   <td><a class="btn btn-primary" asp-action="Details" asp-route-Id="@Department.DeptId"><i class="fas fa-eye"></i>Details</a></td>
					<td><a class="btn btn-success" asp-action="Edite" asp-route-id="@Department.DeptId"><i class="fas fa-edit"></i>Edite</a></td> *@
                    






                    @* Delete With Display Details Before  *@
                    @* <td><a class="btn btn-danger" asp-action="Delete" asp-route-id="@Department.DeptId"><i class="fas fa-trash"></i>Delete</a></td> *@
                   
                    @* Delete Modal  *@
                    <td>
                        <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#DeleteModal-@Department.DeptId">
                            <i class="fas fa-trash"></i> Delete
                        </button>


                        <div class="modal fade" id="DeleteModal-@Department.DeptId" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h1 class="modal-title fs-5" id="exampleModalLabel">Delete Department</h1>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        Are You Sure to Delete this Department?
                                    </div>
                                    <div class="modal-footer">
                                        <form asp-action="Delete" asp-controller="Department" asp-route-id="@Department.DeptId" class="mt-4">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                            <input type="submit" value="Delete" class="btn btn-danger" />
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </td>
                    
				</tr>
             }
       </tbody>
    </table>
}
else
{
    <div class="alert alert-info mt-2">
        <h2>No Departments Found</h2>
    </div>
}
